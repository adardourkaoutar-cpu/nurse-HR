rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User scoped resources for cross-device sync
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Nurses subcollection
      match /nurses/{nurseId} {
        allow read, write: if isOwner(userId) && isValidId(nurseId);
      }

      // Demandes subcollection
      match /demandes/{demandeId} {
        allow read, write: if isOwner(userId) && isValidId(demandeId);
      }

      // Guard schedules subcollection
      match /guardSchedules/{scheduleId} {
        allow read, write: if isOwner(userId) && isValidId(scheduleId);
      }

      // Metadata / backup doc
      match /metadata/{metaId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
